# Alibaba Cloud Model Studio OpenAI-compatible endpoint.
# Replace {WorkspaceId} with the workspace-specific host from the console.
CAREERPILOT_MODEL_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CAREERPILOT_MODEL_API_KEY=replace-me
CAREERPILOT_MODEL_NAME=qwen3.7-plus-2026-05-26
CAREERPILOT_EXPLORATION_TEMPERATURE=0.4
CAREERPILOT_REASONING_TEMPERATURE=0.0

# Alibaba Cloud native DashScope search. Keep the real key out of Git.
DASHSCOPE_API_KEY=replace-me
CAREERPILOT_DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
CAREERPILOT_SEARCH_MODEL=qwen3.7-plus-2026-05-26
CAREERPILOT_SEARCH_DEFAULT_STRATEGY=turbo
CAREERPILOT_SEARCH_ESCALATION_STRATEGY=max
CAREERPILOT_SEARCH_TIMEOUT_SECONDS=45

# Optional OpenAI-compatible dense embeddings. Leave unset for sparse + graph mode.
# CAREERPILOT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# CAREERPILOT_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# CAREERPILOT_EMBEDDING_API_KEY=replace-me
# CAREERPILOT_EMBEDDING_QUERY_INSTRUCTION=Retrieve relevant career knowledge, job information, and interview preparation evidence for the user query.

# MemOS Cloud. Keep the real key only in the environment; never commit it.
MEMOS_API_KEY=replace-me
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1

# Generated local knowledge index.
CAREERPILOT_RAG_DB_PATH=data/rag/careerpilot.db
CAREERPILOT_MEMORY_DB_PATH=data/memory/careerpilot.db
CAREERPILOT_PRODUCT_DB_PATH=data/product/careerpilot.db
CAREERPILOT_ACTION_DB_PATH=data/actions/careerpilot.db

# Governed Personal Agent connectors (single-machine MVP only).
# Production must replace environment-backed user credentials with OAuth callbacks
# and an encrypted, owner-scoped token vault. Never expose these values to the frontend.
CAREERPILOT_FEISHU_CLI_EXECUTABLE=lark-cli
CAREERPILOT_FEISHU_CLI_TIMEOUT_SECONDS=30

# WPS document creation. Required together; leave all unset to disable WPS execution.
# CAREERPILOT_WPS_BASE_URL=https://openapi.wps.cn
# CAREERPILOT_WPS_ACCESS_TOKEN=replace-me
# Optional KSO-1 signing pair; configure both when interface signing is enabled.
# CAREERPILOT_WPS_ACCESS_KEY=replace-me
# CAREERPILOT_WPS_SECRET_KEY=replace-me
# CAREERPILOT_WPS_DRIVE_ID=replace-me
# CAREERPILOT_WPS_PARENT_ID=replace-me

# NetEase Mail recruiting metadata search (read-only IMAP; no message bodies or sending).
# Use the mailbox client authorization code, not the account login password.
# CAREERPILOT_NETEASE_IMAP_HOST=imap.163.com
# CAREERPILOT_NETEASE_IMAP_PORT=993
# CAREERPILOT_NETEASE_ACCOUNT=person@163.com
# CAREERPILOT_NETEASE_AUTHORIZATION_CODE=replace-me
